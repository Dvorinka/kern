# Copy to .env for docker compose (single-host production) or export for local dev.

# --- Required in production / compose ---
KERN_SESSION_SECRET=change-me-32-bytes-plus-characters    # >=32 chars
KERN_SECRET_KEY=change-me-exact-32-bytes-secret-key!!     # exactly 32 chars (AES-256)
KERN_RUNNER_JOIN_TOKEN=change-me-runner-join

# --- Common ---
KERN_ENV=development                                      # development | production
KERN_HTTP_ADDR=:8080
KERN_DATABASE_URL=postgres://kern:kern@localhost:5432/kern?sslmode=disable
KERN_BLOB_DIR=/var/lib/kern/blobs
# S3/MinIO blob driver — set the bucket to switch off the filesystem driver.
# Path-style is implied for any non-AWS endpoint; creds may stay empty to use
# the ambient AWS chain (env, IAM).
# KERN_BLOB_S3_ENDPOINT=minio.internal:9000                    # empty = AWS S3
# KERN_BLOB_S3_REGION=us-east-1
# KERN_BLOB_S3_BUCKET=kern-blobs
# KERN_BLOB_S3_PREFIX=kern
# KERN_BLOB_S3_ACCESS_KEY=
# KERN_BLOB_S3_SECRET_KEY=
# KERN_BLOB_S3_SECURE=true                                   # false for http MinIO
KERN_PUBLIC_URL=http://localhost:8080
KERN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Bootstrap org + admin (created on first boot) ---
KERN_BOOTSTRAP_EMAIL=admin@kern.local
KERN_BOOTSTRAP_PASSWORD=kern-admin-password
KERN_BOOTSTRAP_ORG=kern

# --- Scheduler / leases / retention ---
KERN_SCHEDULER_TICK=2s
KERN_JOB_LEASE=90s
KERN_MAX_JOB_ATTEMPTS=3
KERN_DEFAULT_IMAGE=ghcr.io/dvorinka/kern-ubuntu:24.04          # GitHub-parity toolset; bare ubuntu:24.04 lacks curl/make
# KERN_ARM64_IMAGE=ghcr.io/dvorinka/kern-ubuntu:24.04-arm64    # arm64 substitute for KERN_DEFAULT_IMAGE; empty = no substitution
KERN_LOG_RETENTION=720h                                        # step log+summary blobs; 0 disables
KERN_CACHE_MAX_AGE=168h                                        # actions/cache entries; 0 disables
KERN_WEBHOOK_RETENTION=720h                                    # webhook_deliveries rows; 0 disables
KERN_AUDIT_RETENTION=8760h                                     # audit_events rows; 0 disables
KERN_NOTIFY_RETENTION=720h                                     # notify_deliveries rows; 0 disables

# --- GitHub App (M4, optional now) ---
KERN_GITHUB_APP_ID=
KERN_GITHUB_APP_PRIVATE_KEY=
KERN_GITHUB_WEBHOOK_SECRET=

# --- Updates ---
# Stamp the binary. "dev" is not comparable, so auto-apply stays off.
# KERN_VERSION=v0.3.0
# KERN_RELEASE_REPO=Dvorinka/kern
# External runners only. The compose runner is rebuilt by the host updater.
# KERN_RUNNER_UPDATE=1

# --- Runner agent ---
KERN_CONTROL_URL=http://localhost:8080
KERN_RUNNER_NAME=
KERN_RUNNER_LABELS=
KERN_RUNNER_CONCURRENCY=1                                   # blank = one worker per CPU; 1 = one job given every CPU
KERN_RUNNER_LOAD_GATE=0                                        # pause claims while loadavg1 > n*cpus; 0=off
KERN_RUNNER_IMAGE_MAX_AGE=168h                                 # GC pulled job images; 0=off
KERN_RUNNER_DISK_CRITICAL_FREE_PCT=5                           # critical reclaim tier below this %; 0=off
KERN_RUNNER_DISK_CRITICAL_FLOOR_BYTES=2147483648               # critical tier absolute floor; 0=off
KERN_RUNNER_MEM_MIN_FREE_BYTES=1073741824                  # pause claims while host MemAvailable below this; 0=off
KERN_WORK_ROOT=
KERN_JOB_CPUS=                                                 # blank = equal share of the host; a number pins --cpus
KERN_JOB_MEMORY=1g
